{
  "manifest_version": 3,
  "name": "Repo Shelf",
  "version": "0.1.0",
  "description": "Save GitHub repositories to your local Repo Shelf library with a reason and tags.",
  "key": "",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Repo Shelf"
  },
  "options_page": "options.html"
}
