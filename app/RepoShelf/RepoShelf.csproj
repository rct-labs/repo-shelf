<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms NotifyIcon is the tray API; WPF has none built in. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <RootNamespace>RepoShelf</RootNamespace>
    <AssemblyName>RepoShelf</AssemblyName>
    <Product>Repo Shelf</Product>
    <Company>rct-labs</Company>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Framework-dependent build: this machine already has the .NET 10
         desktop runtime, so the exe stays small (~MB). A self-contained
         publish profile is documented in README for distribution. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RepoShelf.Core\RepoShelf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico" Link="app.ico" />
  </ItemGroup>

</Project>
